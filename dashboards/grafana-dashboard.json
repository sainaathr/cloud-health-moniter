{
  "__inputs": [],
  "__requires": [],
  "annotations": {
    "list": []
  },
  "description": "Auto Kubernetes Health Monitor \u2014 Cluster Overview Dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "title": "\ud83d\udcca Cluster Overview",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "title": "Cluster CPU Usage %",
      "type": "stat",
      "targets": [
        {
          "expr": "(sum(rate(container_cpu_usage_seconds_total{container!=\"\"}[1m])) / sum(machine_cpu_cores)) * 100",
          "legendFormat": "CPU %"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 2,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "title": "Cluster Memory Usage %",
      "type": "stat",
      "targets": [
        {
          "expr": "(sum(container_memory_working_set_bytes{container!=\"\"}) / sum(machine_memory_bytes)) * 100",
          "legendFormat": "Memory %"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "title": "Total Pod Restarts",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"health-monitor\"})",
          "legendFormat": "Restarts"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 4,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "title": "Total Pods Running",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase{phase=\"Running\"})",
          "legendFormat": "Running Pods"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 101,
      "title": "\ud83d\udcc8 Resource Usage Over Time",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "title": "CPU Usage (Node vs Pods)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "(sum(rate(container_cpu_usage_seconds_total{container!=\"\"}[1m])) / sum(machine_cpu_cores)) * 100",
          "legendFormat": "Node CPU %"
        },
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"health-monitor\", container=\"sample-app-ui\"}[1m])) by (pod) * 100",
          "legendFormat": "{{ pod }} CPU %"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "title": "Memory Usage (Node vs Pods)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "(sum(container_memory_working_set_bytes{container!=\"\"}) / sum(machine_memory_bytes)) * 100",
          "legendFormat": "Node Memory %"
        },
        {
          "expr": "(sum(container_memory_working_set_bytes{namespace=\"health-monitor\", container=\"sample-app-ui\"}) by (pod) / (4096*1024*1024)) * 100",
          "legendFormat": "{{ pod }} Mem %"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 102,
      "title": "\ud83d\udc33 Pod Health",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "id": 7,
      "title": "Pod Phase Counts",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase{phase=\"Running\"})",
          "legendFormat": "Running"
        },
        {
          "expr": "sum(kube_pod_status_phase{phase=\"Pending\"})",
          "legendFormat": "Pending"
        },
        {
          "expr": "sum(kube_pod_status_phase{phase=\"Failed\"})",
          "legendFormat": "Failed"
        },
        {
          "expr": "sum(kube_pod_status_phase{phase=\"Unknown\"})",
          "legendFormat": "Unknown"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "id": 8,
      "title": "Pod Restart Count (health-monitor namespace)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (pod) (kube_pod_container_status_restarts_total{namespace=\"health-monitor\"})",
          "legendFormat": "{{ pod }}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "id": 103,
      "title": "\ud83d\ude80 Deployment Replicas",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 9,
      "title": "Deployment Desired vs Available Replicas (health-monitor)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "kube_deployment_spec_replicas{namespace=\"health-monitor\"}",
          "legendFormat": "{{ deployment }} \u2014 Desired"
        },
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"health-monitor\"}",
          "legendFormat": "{{ deployment }} \u2014 Available"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "id": 159,
      "title": "\ud83c\udf10 Application Metrics (Flask)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "id": 160,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"sample-app-service\"}[5m])) by (endpoint, status_code) or sum(rate(http_requests_total{app=\"sample-app\"}[5m])) by (endpoint, status_code)",
          "legendFormat": "{{ endpoint }} ({{ status_code }})"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "id": 161,
      "title": "HTTP Request Average Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "(sum(rate(http_request_duration_seconds_sum{service=\"sample-app-service\"}[5m])) by (endpoint) / sum(rate(http_request_duration_seconds_count{service=\"sample-app-service\"}[5m])) by (endpoint)) > 0",
          "legendFormat": "{{ endpoint }} Latency"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "id": 162,
      "title": "Application Allocated Memory (Bounded Leak)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(app_memory_allocated_bytes{service=\"sample-app-service\"}) by (instance) or sum(app_memory_allocated_bytes) by (instance)",
          "legendFormat": "{{ instance }} Memory"
        },
        {
          "expr": "sum(app_memory_allocated_bytes{service=\"sample-app-service\"}) or sum(app_memory_allocated_bytes)",
          "legendFormat": "Total Bounded Leak"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "id": 163,
      "title": "HTTP Errors (5xx)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_code=~\"5..\", service=\"sample-app-service\"}[5m])) by (endpoint, status_code) or vector(0)",
          "legendFormat": "{{ endpoint }} - {{ status_code }}"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": [
    "kubernetes",
    "health-monitor"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data Source",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Auto K8s Health Monitor",
  "uid": "auto-k8s-health",
  "version": 1
}