# ==============================================================================
# Auto Kubernetes Health Monitoring & Self-Healing Control Plane
# Environment Variable Configuration Template
# ==============================================================================
# Copy this file to '.env' for local runs, or configure via Kubernetes Secrets.
# WARNING: NEVER commit actual credentials or production secrets to Git!
# ==============================================================================

# ── 1. Application & Cluster Settings ─────────────────────────────────────────
PORT=5000
FLASK_ENV=production
WATCH_NAMESPACE=health-monitor
POLL_INTERVAL=30
INCIDENT_DB_PATH=incidents.db
DASHBOARD_URL=http://localhost:5000

# ── 2. Chaos & Security Gates ─────────────────────────────────────────────────
# Destructive chaos (/api/chaos/oom, /api/chaos/crash) is DISABLED by default.
ENABLE_DESTRUCTIVE_CHAOS=false
CHAOS_AUTH_TOKEN=k8s-chaos-admin-secure

# ── 3. Notification & Alerting Settings (SMTP & Telegram) ─────────────────────
# Alert backend options: "email", "telegram", "both", or "none"
ALERT_BACKEND=email
ALERT_ENABLED=true

# When true, emails are formatted and logged to incident store without network dispatch.
# Set to false once sender credentials (SMTP_USER and SMTP_PASSWORD) are configured below.
# If unset, defaults to true whenever SMTP_USER or SMTP_PASSWORD are not provided.
SMTP_DRY_RUN=true

# Target recipient for all failure, recovery, and diagnostic notifications
# Default recipient configured for this cluster:
SMTP_TO_EMAIL=sainaath.r2025@vitstudent.ac.in
ALERT_TO_EMAIL=sainaath.r2025@vitstudent.ac.in

# SMTP Server details (e.g. smtp.gmail.com, smtp.office365.com, sendgrid, or corporate relay)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Encryption mode:
# - Set SMTP_USE_TLS=true for STARTTLS (recommended for Port 587 or 25)
# - Set SMTP_USE_SSL=true for direct SSL/TLS sockets (recommended for Port 465)
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Timeouts & Rate-limiting
SMTP_TIMEOUT_SECONDS=10
SMTP_TIMEOUT_SEC=10
ALERT_COOLDOWN_SEC=300

# Sender identity
SMTP_FROM_EMAIL=k8s-monitor@cloud-health.local
SMTP_FROM=k8s-monitor@cloud-health.local

# Sender credentials (REQUIRED for live email delivery)
# For Gmail / Google Workspace: Use your full email and a 16-character App Password (not your account password)
# https://myaccount.google.com/apppasswords
SMTP_USERNAME=your-sending-email@gmail.com
SMTP_USER=your-sending-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password

# Telegram Bot Integration (Optional)
# Obtained from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 4. Controller Self-Healing Thresholds ─────────────────────────────────────
MAX_RECOVERY_ATTEMPTS=3
RECOVERY_COOLDOWN=60
RECOVERY_TIMEOUT=120
RESTART_THRESHOLD=5
CPU_WARNING_THRESHOLD=70
CPU_CRITICAL_THRESHOLD=85
MEM_WARNING_THRESHOLD=70
MEM_CRITICAL_THRESHOLD=85
